<!--
  Generates the PaperyTestFiles folder: every PDF and image used for manual
  and automated testing. See README.md in this folder for how to run it.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows TFM so we can use the built-in Windows imaging codecs (JPEG, PNG, HEIC, TIFF, BMP). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Papery.TestFiles</RootNamespace>
    <!-- This is a developer tool: relax rules aimed at shipping library code. -->
    <NoWarn>$(NoWarn);CA1303;CA1305;CA1310;CA1812;CA1822;CA1861;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Papery.Pdf\Papery.Pdf.csproj" />
    <PackageReference Include="PDFsharp" />
  </ItemGroup>
</Project>
