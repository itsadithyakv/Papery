<!--
  Organise mode: every page as a card on a board. Drag to reorder, turn, remove, duplicate,
  add blank pages or pages from other PDFs, then save. Nothing touches the file until Save.
-->
<UserControl
    x:Class="Papery.Views.OrganiseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:organise="using:Papery.Views.Organise"
    xmlns:controls="using:Papery.Controls"
    KeyboardAcceleratorPlacementMode="Hidden">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Delete" Invoked="OnDeleteShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnUndoShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="OnRedoShortcut" />
        <KeyboardAccelerator Modifiers="Control,Shift" Key="Z" Invoked="OnRedoShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="OnRotateRightShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnRotateLeftShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="D" Invoked="OnDuplicateShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnSaveShortcut" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeShortcut" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="Root" Background="{ThemeResource PaperyCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Toolbar: icons for actions, words only for the decisions ============ -->
        <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource PaperyDividerBrush}" Background="{ThemeResource PaperySurfaceBrush}">
            <Grid MinHeight="{StaticResource PaperyToolbarHeight}" Padding="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="RotateLeftButton" Style="{StaticResource ToolButtonStyle}" Click="OnRotateLeft" AutomationProperties.Name="Turn left" ToolTipService.ToolTip="Turn left (Ctrl+L)">
                            <FontIcon Glyph="&#xE7AD;" Style="{StaticResource ToolIconStyle}" RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>
                        <Button x:Name="RotateRightButton" Style="{StaticResource ToolButtonStyle}" Click="OnRotateRight" AutomationProperties.Name="Turn right" ToolTipService.ToolTip="Turn right (Ctrl+R)">
                            <FontIcon Glyph="&#xE7AD;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button x:Name="DeleteButton" Style="{StaticResource ToolButtonStyle}" Click="OnDelete" AutomationProperties.Name="Delete pages" ToolTipService.ToolTip="Delete (Del)">
                            <FontIcon Glyph="&#xE74D;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                        <Button x:Name="DuplicateButton" Style="{StaticResource ToolButtonStyle}" Click="OnDuplicate" AutomationProperties.Name="Duplicate pages" ToolTipService.ToolTip="Duplicate (Ctrl+D)">
                            <FontIcon Glyph="&#xE8C8;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnInsertBlank" AutomationProperties.Name="Add a blank page" ToolTipService.ToolTip="Add a blank page">
                            <FontIcon Glyph="&#xE710;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnInsertFile" AutomationProperties.Name="Add pages from another PDF" ToolTipService.ToolTip="Add pages from another PDF (or drop files here)">
                            <FontIcon Glyph="&#xE8E5;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                        <Button x:Name="ExtractButton" Style="{StaticResource ToolButtonStyle}" Click="OnExtract" AutomationProperties.Name="Save selected pages as a new PDF" ToolTipService.ToolTip="Save selected pages as a new PDF">
                            <FontIcon Glyph="&#xEDE1;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button x:Name="SplitButton" Style="{StaticResource ToolButtonStyle}" Click="OnSplit" AutomationProperties.Name="Split into several PDFs" ToolTipService.ToolTip="Split into several PDFs">
                            <FontIcon Glyph="&#xE8C6;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                        <Button x:Name="UndoButton" Style="{StaticResource ToolButtonStyle}" Click="OnUndo" AutomationProperties.Name="Undo" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                            <FontIcon Glyph="&#xE7A7;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button x:Name="RedoButton" Style="{StaticResource ToolButtonStyle}" Click="OnRedo" AutomationProperties.Name="Redo" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                            <FontIcon Glyph="&#xE7A6;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE71F;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource PaperyIcons}" />
                    <Slider x:Name="SizeSlider" Width="110" Minimum="110" Maximum="320" StepFrequency="10" Value="170"
                            VerticalAlignment="Center" AutomationProperties.Name="Page size on screen"
                            IsThumbToolTipEnabled="False" />
                    <FontIcon Glyph="&#xE8A3;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource PaperyIcons}" />
                    <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                    <Button x:Name="DoneButton" Content="Done" Style="{StaticResource PaperyQuietButtonStyle}" Click="OnDone" ToolTipService.ToolTip="Back to reading (Esc)" />
<Button x:Name="SaveCopyButton" Style="{StaticResource ToolButtonStyle}" Click="OnSaveCopyClick" AutomationProperties.Name="Save as a copy" ToolTipService.ToolTip="Save as a copy (leaves this file as it is)">
                        <FontIcon Glyph="&#xE792;" Style="{StaticResource ToolIconStyle}" />
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource PaperyPrimaryButtonStyle}" Click="OnSaveClick" ToolTipService.ToolTip="Save changes to this file (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" FontFamily="{StaticResource PaperyIcons}" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ The board ============ -->
        <GridView x:Name="Board" Grid.Row="1" Padding="20,16,20,24"
                  SelectionMode="Extended" IsItemClickEnabled="False"
                  CanDragItems="True" CanReorderItems="True" AllowDrop="True"
                  DragItemsStarting="OnDragItemsStarting" DragItemsCompleted="OnDragItemsCompleted"
                  DragOver="OnBoardDragOver" Drop="OnBoardDrop"
                  SelectionChanged="OnSelectionChanged" ContainerContentChanging="OnContainerContentChanging"
                  PointerWheelChanged="OnBoardWheel"
                  AutomationProperties.Name="Pages">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="Padding" Value="4" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="organise:OrganisePage">
                    <controls:PageTile />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- ============ Status: counts and the most useful keys, as keycaps ============ -->
        <Grid Grid.Row="2" Padding="16,6" Background="{ThemeResource PaperySurfaceBrush}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource PaperyDividerBrush}">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{StaticResource PaperySecondaryTextStyle}" />
            <StackPanel x:Name="HintRow" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14" />
        </Grid>

        <!-- ============ Saving: the character waits with you ============ -->
        <Grid x:Name="BusyOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="{ThemeResource PaperyCanvasBrush}" Opacity="0.96">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Width="280">
                <controls:Mascot x:Name="BusyMascot" Width="64" Height="76" HorizontalAlignment="Center" />
                <TextBlock x:Name="BusyText" Text="Saving" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                <ProgressBar x:Name="BusyProgress" Maximum="1" />
                <Button x:Name="BusyCancel" Content="Cancel" HorizontalAlignment="Center" Style="{StaticResource PaperyQuietButtonStyle}" Click="OnBusyCancel" />
            </StackPanel>
        </Grid>

        <controls:Toast x:Name="Toaster" Grid.Row="1" />
    </Grid>
</UserControl>
