<UserControl
    x:Class="Papery.Views.HelpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PaperySurfaceBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="820" Padding="32,28,32,40" Spacing="4">
            <TextBlock Text="Help and keyboard shortcuts" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Everything in Papery works with the keyboard. Shortcuts are also shown when you hover over a button."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,8" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BE;" FontSize="22" Foreground="{ThemeResource PaperyCoralBrush}" FontFamily="{StaticResource PaperyIcons}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Take a one-minute tour" />
                        <TextBlock Text="Open any PDF, then choose More (⋯) › Take the tour to see the viewer's controls one by one."
                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Show the home tour" Click="OnHomeTourClick" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Shortcut tables are built in code from one list (HelpView.xaml.cs) so they never drift apart. -->
            <StackPanel x:Name="Sections" Spacing="4" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
