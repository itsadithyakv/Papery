<UserControl
    x:Class="Papery.Views.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Papery.Views"
    xmlns:controls="using:Papery.Controls"
    KeyboardAcceleratorPlacementMode="Hidden">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindShortcut" />
        <KeyboardAccelerator Key="F3" Invoked="OnFindNextShortcut" />
        <KeyboardAccelerator Modifiers="Shift" Key="F3" Invoked="OnFindPreviousShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="P" Invoked="OnPrintShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="OnCopyShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="A" Invoked="OnSelectAllShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="D" Invoked="OnPropertiesShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="G" Invoked="OnGoToPageShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="Number0" Invoked="OnFitPageShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnActualSizeShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnFitWidthShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="Add" Invoked="OnZoomInShortcut" />
        <KeyboardAccelerator Modifiers="Control" Key="Subtract" Invoked="OnZoomOutShortcut" />
        <KeyboardAccelerator Key="F5" Invoked="OnPresentShortcut" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeShortcut" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Mode bar: the big, clear modes (pills; arrow keys move between them) ============ -->
        <Grid x:Name="ModeBar" Padding="12,8,12,6" Background="{ThemeResource PaperySurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                <!-- Modes: items are added in DocumentView.xaml.cs; the coral blob slides between them. -->
                <controls:PillBar x:Name="Modes" AutomationProperties.Name="Modes" />
            </ScrollViewer>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="8,0,0,0">
                <Button x:Name="SearchButton" Style="{StaticResource ToolButtonStyle}" Click="OnSearchClick" AutomationProperties.Name="Search" ToolTipService.ToolTip="Search (Ctrl+F)">
                    <FontIcon Glyph="&#xE721;" Style="{StaticResource ToolIconStyle}" />
                </Button>
                <Button x:Name="PrintButton" Style="{StaticResource ToolButtonStyle}" Click="OnPrintClick" AutomationProperties.Name="Print" ToolTipService.ToolTip="Print (Ctrl+P)">
                    <FontIcon Glyph="&#xE749;" Style="{StaticResource ToolIconStyle}" />
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource ToolButtonStyle}" AutomationProperties.Name="More options" ToolTipService.ToolTip="More options">
                    <FontIcon Glyph="&#xE712;" Style="{StaticResource ToolIconStyle}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Present" Click="OnPresentClick" KeyboardAcceleratorTextOverride="F5">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE786;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Properties" Click="OnPropertiesClick" KeyboardAcceleratorTextOverride="Ctrl+D">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Show in folder" Click="OnShowInFolderClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Take the tour" Click="OnTourClick">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7BE;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Keyboard shortcuts" Click="OnHelpClick" KeyboardAcceleratorTextOverride="F1">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Settings" Click="OnSettingsClick" KeyboardAcceleratorTextOverride="Ctrl+,">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ Secondary toolbar for the current mode ============ -->
        <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource PaperyDividerBrush}"
                Background="{ThemeResource PaperySurfaceBrush}" x:Name="ToolbarArea">
            <Grid MinHeight="{StaticResource PaperyToolbarHeight}" Padding="8,0">
                <!-- View tools -->
                <Grid x:Name="ViewToolbar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton x:Name="SidebarToggle" Style="{StaticResource ToolToggleButtonStyle}" Click="OnSidebarToggle"
                                      AutomationProperties.Name="Show sidebar" ToolTipService.ToolTip="Show or hide the sidebar">
                            <FontIcon Glyph="&#xE8A0;" Style="{StaticResource ToolIconStyle}" />
                        </ToggleButton>
                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnPreviousPage" AutomationProperties.Name="Previous page" ToolTipService.ToolTip="Previous page">
                            <FontIcon Glyph="&#xE70E;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <TextBox x:Name="PageBox" Width="64" VerticalAlignment="Center" TextAlignment="Center"
                                 KeyDown="OnPageBoxKeyDown" LostFocus="OnPageBoxLostFocus" GotFocus="OnPageBoxGotFocus"
                                 AutomationProperties.Name="Page number" ToolTipService.ToolTip="Go to page (Ctrl+G)" />
                        <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Margin="6,0,2,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnNextPage" AutomationProperties.Name="Next page" ToolTipService.ToolTip="Next page">
                            <FontIcon Glyph="&#xE70D;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnZoomOut" AutomationProperties.Name="Zoom out" ToolTipService.ToolTip="Zoom out (Ctrl+-)">
                            <FontIcon Glyph="&#xE71F;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <DropDownButton x:Name="ZoomButton" Style="{StaticResource ToolDropDownStyle}" MinWidth="88" AutomationProperties.Name="Zoom level">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="ZoomMenu">
                                    <MenuFlyoutItem Text="Fit width" Click="OnFitWidth" KeyboardAcceleratorTextOverride="Ctrl+2" />
                                    <MenuFlyoutItem Text="Fit page" Click="OnFitPage" KeyboardAcceleratorTextOverride="Ctrl+0" />
                                    <MenuFlyoutItem Text="Actual size" Click="OnActualSize" KeyboardAcceleratorTextOverride="Ctrl+1" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="50%" Tag="0.5" Click="OnZoomPreset" />
                                    <MenuFlyoutItem Text="75%" Tag="0.75" Click="OnZoomPreset" />
                                    <MenuFlyoutItem Text="100%" Tag="1" Click="OnZoomPreset" />
                                    <MenuFlyoutItem Text="125%" Tag="1.25" Click="OnZoomPreset" />
                                    <MenuFlyoutItem Text="150%" Tag="1.5" Click="OnZoomPreset" />
                                    <MenuFlyoutItem Text="200%" Tag="2" Click="OnZoomPreset" />
                                    <MenuFlyoutItem Text="400%" Tag="4" Click="OnZoomPreset" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnZoomIn" AutomationProperties.Name="Zoom in" ToolTipService.ToolTip="Zoom in (Ctrl++)">
                            <FontIcon Glyph="&#xE8A3;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />

                        <DropDownButton x:Name="LayoutButton" Style="{StaticResource ToolDropDownStyle}" AutomationProperties.Name="Page layout" ToolTipService.ToolTip="Page layout">
                            <FontIcon x:Name="LayoutIcon" Glyph="&#xE8A1;" Style="{StaticResource ToolIconStyle}" />
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <RadioMenuFlyoutItem x:Name="LayoutSingle" Text="Single page" GroupName="layout" Click="OnLayoutClick" Tag="SinglePage" />
                                    <RadioMenuFlyoutItem x:Name="LayoutContinuous" Text="Continuous scrolling" GroupName="layout" Click="OnLayoutClick" Tag="Continuous" />
                                    <RadioMenuFlyoutItem x:Name="LayoutTwoPage" Text="Two pages side by side" GroupName="layout" Click="OnLayoutClick" Tag="TwoPage" />
                                    <RadioMenuFlyoutItem x:Name="LayoutBook" Text="Book (cover page alone)" GroupName="layout" Click="OnLayoutClick" Tag="Book" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <DropDownButton x:Name="ReadingButton" Style="{StaticResource ToolDropDownStyle}" AutomationProperties.Name="Reading mode" ToolTipService.ToolTip="Reading mode: page colours">
                            <FontIcon Glyph="&#xE793;" Style="{StaticResource ToolIconStyle}" />
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <RadioMenuFlyoutItem x:Name="ReadingLight" Text="Light (original colours)" GroupName="reading" Click="OnReadingClick" Tag="Light" />
                                    <RadioMenuFlyoutItem x:Name="ReadingDark" Text="Dark" GroupName="reading" Click="OnReadingClick" Tag="Dark" />
                                    <RadioMenuFlyoutItem x:Name="ReadingSepia" Text="Sepia" GroupName="reading" Click="OnReadingClick" Tag="Sepia" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button x:Name="ViewSave" Style="{StaticResource PaperyPrimaryButtonStyle}" Margin="0,0,6,0" Click="OnAnnotateSave" Visibility="Collapsed" ToolTipService.ToolTip="Save your changes into this file (Ctrl+S)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" FontFamily="{StaticResource PaperyIcons}" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnPresentClick" AutomationProperties.Name="Present" ToolTipService.ToolTip="Present full screen (F5)">
                            <FontIcon Glyph="&#xE786;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Annotate tools (built in code, DocumentView.Annotate.cs) -->
                <Grid x:Name="AnnotateToolbar" Visibility="Collapsed" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <StackPanel x:Name="AnnotateTools" Orientation="Horizontal" Spacing="2" />
                            <StackPanel x:Name="AnnotateColours" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="AnnotateUndo" Style="{StaticResource ToolButtonStyle}" Click="OnAnnotateUndo" IsEnabled="False" AutomationProperties.Name="Undo" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                            <FontIcon Glyph="&#xE7A7;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button x:Name="AnnotateRedo" Style="{StaticResource ToolButtonStyle}" Click="OnAnnotateRedo" IsEnabled="False" AutomationProperties.Name="Redo" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                            <FontIcon Glyph="&#xE7A6;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button x:Name="AnnotateSave" Style="{StaticResource PaperyPrimaryButtonStyle}" Margin="6,0,0,0" Click="OnAnnotateSave" IsEnabled="False" ToolTipService.ToolTip="Save annotations into this file (Ctrl+S)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" FontFamily="{StaticResource PaperyIcons}" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Fill & Sign tools -->
                <Grid x:Name="FillToolbar" Visibility="Collapsed" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                        <StackPanel x:Name="FillTools" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource ToolToggleButtonStyle}" Click="OnTypeHere" AutomationProperties.Name="Type on the page" ToolTipService.ToolTip="Type on the page">
                                <FontIcon Glyph="&#xE8D2;" Style="{StaticResource ToolIconStyle}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ToolToggleButtonStyle}" Click="OnTick" AutomationProperties.Name="Tick" ToolTipService.ToolTip="Tick">
                                <FontIcon Glyph="&#xE73E;" Style="{StaticResource ToolIconStyle}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ToolToggleButtonStyle}" Click="OnCross" AutomationProperties.Name="Cross" ToolTipService.ToolTip="Cross">
                                <FontIcon Glyph="&#xE711;" Style="{StaticResource ToolIconStyle}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ToolToggleButtonStyle}" Click="OnDot" AutomationProperties.Name="Dot" ToolTipService.ToolTip="Dot">
                                <FontIcon Glyph="&#xF127;" Style="{StaticResource ToolIconStyle}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ToolToggleButtonStyle}" Click="OnDate" AutomationProperties.Name="Today's date" ToolTipService.ToolTip="Today's date">
                                <FontIcon Glyph="&#xE787;" Style="{StaticResource ToolIconStyle}" />
                            </ToggleButton>
                            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                            <Button Style="{StaticResource PaperySecondaryButtonStyle}" AutomationProperties.Name="Sign" ToolTipService.ToolTip="Signatures and initials">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEE56;" FontSize="14" FontFamily="{StaticResource PaperyIcons}" />
                                    <TextBlock Text="Sign" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="SignFlyout" Opening="OnSignMenuOpening">
                                        <StackPanel x:Name="SignMenu" Spacing="4" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                            <DropDownButton Style="{StaticResource ToolDropDownStyle}" AutomationProperties.Name="Add a form field" ToolTipService.ToolTip="Add a form field">
                                <FontIcon Glyph="&#xE710;" Style="{StaticResource ToolIconStyle}" />
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Text field" Tag="Text" Click="OnAddField" />
                                        <MenuFlyoutItem Text="Tick box" Tag="CheckBox" Click="OnAddField" />
                                        <MenuFlyoutItem Text="Dropdown" Tag="ComboBox" Click="OnAddField" />
                                        <MenuFlyoutItem Text="Signature field" Tag="Signature" Click="OnAddField" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Style="{StaticResource ToolButtonStyle}" Click="OnFindFields" AutomationProperties.Name="Find fields on this printed form" ToolTipService.ToolTip="Find fields on this printed form">
                                <FontIcon Glyph="&#xE721;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                            <Button Style="{StaticResource ToolButtonStyle}" Click="OnFlatten" AutomationProperties.Name="Make answers permanent" ToolTipService.ToolTip="Make answers permanent (flatten)">
                                <FontIcon Glyph="&#xE72E;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="FillUndo" Style="{StaticResource ToolButtonStyle}" Click="OnAnnotateUndo" IsEnabled="False" AutomationProperties.Name="Undo" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                            <FontIcon Glyph="&#xE7A7;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button x:Name="FillRedo" Style="{StaticResource ToolButtonStyle}" Click="OnAnnotateRedo" IsEnabled="False" AutomationProperties.Name="Redo" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                            <FontIcon Glyph="&#xE7A6;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button x:Name="FillSave" Style="{StaticResource PaperyPrimaryButtonStyle}" Margin="6,0,0,0" Click="OnAnnotateSave" IsEnabled="False" ToolTipService.ToolTip="Save into this file (Ctrl+S)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" FontFamily="{StaticResource PaperyIcons}" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Edit: added text, pictures, whiteout and links; numbers, watermarks and bookmarks -->
                <Grid x:Name="EditToolbar" Visibility="Collapsed" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <ToggleButton x:Name="EditSelect" Style="{StaticResource ToolToggleButtonStyle}" Click="OnEditSelect" AutomationProperties.Name="Select, move or resize" ToolTipService.ToolTip="Select, move or resize">
                                <FontIcon Glyph="&#xE8B0;" Style="{StaticResource ToolIconStyle}" />
                            </ToggleButton>
                            <ToggleButton x:Name="EditText" Style="{StaticResource ToolToggleButtonStyle}" Click="OnEditText" AutomationProperties.Name="Add text" ToolTipService.ToolTip="Add text">
                                <FontIcon Glyph="&#xE8D2;" Style="{StaticResource ToolIconStyle}" />
                            </ToggleButton>
                            <Button Style="{StaticResource ToolButtonStyle}" Click="OnEditImage" AutomationProperties.Name="Add a picture" ToolTipService.ToolTip="Add a picture">
                                <FontIcon Glyph="&#xEB9F;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                            <ToggleButton x:Name="EditCover" Style="{StaticResource ToolToggleButtonStyle}" Click="OnEditCover" AutomationProperties.Name="Whiteout" ToolTipService.ToolTip="Whiteout: cover part of the page">
                                <FontIcon Glyph="&#xE75C;" Style="{StaticResource ToolIconStyle}" />
                            </ToggleButton>
                            <StackPanel x:Name="CoverColourHost" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0" />
                            <ToggleButton x:Name="EditLink" Style="{StaticResource ToolToggleButtonStyle}" Click="OnEditLink" AutomationProperties.Name="Links" ToolTipService.ToolTip="Add or change a link">
                                <FontIcon Glyph="&#xE71B;" Style="{StaticResource ToolIconStyle}" />
                            </ToggleButton>
                            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                            <Button Style="{StaticResource ToolButtonStyle}" Tag="PageNumbers" Click="OnEditStamp" AutomationProperties.Name="Page numbers" ToolTipService.ToolTip="Page numbers">
                                <FontIcon Glyph="&#xE8EF;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                            <Button Style="{StaticResource ToolButtonStyle}" Tag="HeaderFooter" Click="OnEditStamp" AutomationProperties.Name="Header or footer" ToolTipService.ToolTip="Header or footer">
                                <FontIcon Glyph="&#xE8A5;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                            <Button Style="{StaticResource ToolButtonStyle}" Tag="Watermark" Click="OnEditStamp" AutomationProperties.Name="Watermark" ToolTipService.ToolTip="Watermark">
                                <FontIcon Glyph="&#xE790;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                            <Button Style="{StaticResource ToolButtonStyle}" Tag="Bates" Click="OnEditStamp" AutomationProperties.Name="Bates numbers" ToolTipService.ToolTip="Bates numbers">
                                <FontIcon Glyph="&#xE8C7;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                            <Button Style="{StaticResource ToolButtonStyle}" Click="OnEditBookmarks" AutomationProperties.Name="Bookmarks" ToolTipService.ToolTip="Edit bookmarks">
                                <FontIcon Glyph="&#xE8A4;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                            <Button x:Name="EditChangeWords" Visibility="Collapsed" Style="{StaticResource ToolButtonStyle}" Click="OnEditChangeWords" AutomationProperties.Name="Change the words" ToolTipService.ToolTip="Change the words">
                                <FontIcon Glyph="&#xE70F;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                            <Button x:Name="EditTurn" Visibility="Collapsed" Style="{StaticResource ToolButtonStyle}" Click="OnEditTurn" AutomationProperties.Name="Turn" ToolTipService.ToolTip="Turn">
                                <FontIcon Glyph="&#xE7AD;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                            <Button x:Name="EditDelete" Visibility="Collapsed" Style="{StaticResource ToolButtonStyle}" Click="OnEditDelete" AutomationProperties.Name="Delete" ToolTipService.ToolTip="Delete">
                                <FontIcon Glyph="&#xE74D;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="EditUndo" Style="{StaticResource ToolButtonStyle}" Click="OnAnnotateUndo" IsEnabled="False" AutomationProperties.Name="Undo" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                            <FontIcon Glyph="&#xE7A7;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button x:Name="EditRedo" Style="{StaticResource ToolButtonStyle}" Click="OnAnnotateRedo" IsEnabled="False" AutomationProperties.Name="Redo" ToolTipService.ToolTip="Redo (Ctrl+Y)">
                            <FontIcon Glyph="&#xE7A6;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button x:Name="EditSave" Style="{StaticResource PaperyPrimaryButtonStyle}" Margin="6,0,0,0" Click="OnAnnotateSave" IsEnabled="False" ToolTipService.ToolTip="Save into this file (Ctrl+S)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" FontFamily="{StaticResource PaperyIcons}" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Convert: pages and pictures out, new PDFs in -->
                <ScrollViewer x:Name="ConvertToolbar" Visibility="Collapsed" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnSavePagesAsImages" AutomationProperties.Name="Save pages as pictures" ToolTipService.ToolTip="Save pages as pictures">
                            <FontIcon Glyph="&#xEB9F;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <ToggleButton x:Name="ConvertSnapshot" Style="{StaticResource ToolToggleButtonStyle}" Click="OnSnapshot" AutomationProperties.Name="Snapshot" ToolTipService.ToolTip="Snapshot: copy part of a page as a picture">
                            <FontIcon Glyph="&#xE7A8;" Style="{StaticResource ToolIconStyle}" />
                        </ToggleButton>
                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnExtractPictures" AutomationProperties.Name="Save the pictures in this PDF" ToolTipService.ToolTip="Save the pictures in this PDF">
                            <FontIcon Glyph="&#xE8B9;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnSaveText" AutomationProperties.Name="Save as text" ToolTipService.ToolTip="Save as text">
                            <FontIcon Glyph="&#xE8A5;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnCopyAllText" AutomationProperties.Name="Copy all the text" ToolTipService.ToolTip="Copy all the text">
                            <FontIcon Glyph="&#xE8C8;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnImagesToPdf" AutomationProperties.Name="Images to PDF" ToolTipService.ToolTip="Make a PDF from pictures">
                            <FontIcon Glyph="&#xE7C5;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnScan" AutomationProperties.Name="Scan to PDF" ToolTipService.ToolTip="Scan to PDF">
                            <FontIcon Glyph="&#xE8FE;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                        <Button Style="{StaticResource ToolButtonStyle}" Click="OnPrintToPdfHelp" AutomationProperties.Name="Make a PDF from any app" ToolTipService.ToolTip="Make a PDF from any app">
                            <FontIcon Glyph="&#xE749;" Style="{StaticResource ToolIconStyle}" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Placeholder for modes built in later stages -->
                <TextBlock x:Name="ComingSoonText" VerticalAlignment="Center" Margin="8,0" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- ============ Sidebar + pages ============ -->
        <Grid x:Name="ReadingArea" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Sidebar" Width="280" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource PaperyDividerBrush}"
                  Background="{ThemeResource PaperySidebarBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <controls:PillBar x:Name="SidebarTabs" EqualWidths="True" Margin="12,12,12,6" AutomationProperties.Name="Sidebar" />

                <!-- Page thumbnails (virtualised: only visible ones are rendered) -->
                <ListView x:Name="ThumbnailList" Grid.Row="1" SelectionMode="Single" Padding="0,8"
                          ContainerContentChanging="OnThumbnailContainerChanging" SelectionChanged="OnThumbnailSelected"
                          AutomationProperties.Name="Page thumbnails">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ThumbnailItem">
                            <StackPanel Spacing="4" AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Border Width="{x:Bind Width}" Height="{x:Bind Height}" Background="{ThemeResource PaperyCardBrush}" CornerRadius="2"
                                        BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                    <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{x:Bind Label}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Bookmarks (outline) -->
                <Grid x:Name="BookmarksPanel" Grid.Row="1" Visibility="Collapsed">
                    <TreeView x:Name="OutlineTree" SelectionMode="None" ItemInvoked="OnOutlineInvoked" AutomationProperties.Name="Bookmarks">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="local:OutlineNode">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded}"
                                              AutomationProperties.Name="{x:Bind Title}">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <!-- Empty state: a sleepy character instead of a bare sentence. -->
                    <StackPanel x:Name="NoBookmarksText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="16">
                        <controls:Mascot Mood="Sleepy" Width="56" Height="66" IsFloating="False" />
                        <TextBlock Text="No bookmarks here" HorizontalAlignment="Center" Style="{StaticResource PaperySecondaryTextStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Comments: every annotation in the document -->
                <Grid x:Name="CommentsPanel" Grid.Row="1" Visibility="Collapsed">
                    <ListView x:Name="CommentsList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnCommentClick" AutomationProperties.Name="Comments and annotations">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CommentItem">
                                <Grid Padding="0,8" ColumnSpacing="8" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="12" Height="12" Fill="{x:Bind Swatch}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind PageLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource PaperyQuietButtonStyle}" Tag="{x:Bind}" Click="OnCommentEdit" Padding="6" MinWidth="0" AutomationProperties.Name="Edit the words" ToolTipService.ToolTip="Edit the words">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" FontFamily="{StaticResource PaperyIcons}" />
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource PaperyQuietButtonStyle}" Tag="{x:Bind}" Click="OnCommentDelete" Padding="6" MinWidth="0" AutomationProperties.Name="Delete" ToolTipService.ToolTip="Delete">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" FontFamily="{StaticResource PaperyIcons}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="NoCommentsText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="16">
                        <controls:Mascot Mood="Sleepy" Width="56" Height="66" IsFloating="False" />
                        <TextBlock Text="No comments yet" HorizontalAlignment="Center" Style="{StaticResource PaperySecondaryTextStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Search -->
                <Grid x:Name="SearchPanel" Grid.Row="1" Visibility="Collapsed" Padding="12,8,12,0" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="Search this document" KeyDown="OnSearchBoxKeyDown"
                             AutomationProperties.Name="Search text" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                        <CheckBox x:Name="MatchCaseBox" Content="Match case" MinWidth="0" Click="OnSearchOptionChanged" />
                        <CheckBox x:Name="WholeWordBox" Content="Whole words" MinWidth="0" Click="OnSearchOptionChanged" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="SearchStatus" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,72,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ToolButtonStyle}" Click="OnFindPrevious" AutomationProperties.Name="Previous result" ToolTipService.ToolTip="Previous result (Shift+F3)">
                                <FontIcon Glyph="&#xE70E;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                            <Button Style="{StaticResource ToolButtonStyle}" Click="OnFindNext" AutomationProperties.Name="Next result" ToolTipService.ToolTip="Next result (F3)">
                                <FontIcon Glyph="&#xE70D;" Style="{StaticResource ToolIconStyle}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="SearchResults" Grid.Row="3" SelectionMode="Single" IsItemClickEnabled="True"
                              ItemClick="OnSearchResultClick" AutomationProperties.Name="Search results" Margin="-12,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SearchResultItem">
                                <StackPanel Padding="0,6" AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <TextBlock Text="{x:Bind PageLabel}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Context}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <controls:PdfViewer x:Name="Viewer" Grid.Column="1">
                <controls:PdfViewer.ContextFlyout>
                    <MenuFlyout Opening="OnViewerMenuOpening">
                        <MenuFlyoutItem x:Name="CopyMenuItem" Text="Copy" Click="OnCopyClick" KeyboardAcceleratorTextOverride="Ctrl+C">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Select all text on this page" Click="OnSelectAllClick" KeyboardAcceleratorTextOverride="Ctrl+A" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Print..." Click="OnPrintClick">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE749;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Properties" Click="OnPropertiesClick">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </controls:PdfViewer.ContextFlyout>
            </controls:PdfViewer>

            <!-- Notices float over the page, so they get a solid card background to stay readable. -->
            <controls:Toast x:Name="Toaster" Grid.Column="1" />
            <InfoBar x:Name="Notice" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,12" MaxWidth="640" IsOpen="False"
                     Background="{ThemeResource PaperyCardBrush}" BorderBrush="{ThemeResource PaperyCardBorderBrush}" BorderThickness="1" CornerRadius="12" />
        </Grid>
    </Grid>
</UserControl>
