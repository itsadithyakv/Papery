<UserControl
    x:Class="Papery.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Papery.Controls"
    Background="{ThemeResource PaperySurfaceBrush}">

    <ScrollViewer>
        <StackPanel MaxWidth="820" Padding="32,28,32,40" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <!-- Papery Pro: status, Buy, and Restore purchase (backup for the automatic check at start-up). -->
            <TextBlock Text="Papery Pro" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <controls:Mascot x:Name="ProMascot" Width="40" Height="48" IsFloating="False" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ProTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="ProSubtitle" Style="{StaticResource PaperySecondaryTextStyle}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="RestoreButton" Content="Restore purchase" Style="{StaticResource PaperySecondaryButtonStyle}" Click="OnRestoreClick" />
                        <Button x:Name="BuyButton" Content="Get Papery Pro" Style="{StaticResource PaperyPrimaryButtonStyle}" Click="OnBuyClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Developer builds only (made visible in code inside #if DEBUG; absent from Store builds). -->
            <StackPanel x:Name="DeveloperSection" Visibility="Collapsed" Spacing="4">
                <TextBlock Text="Developer (Debug builds only)" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pretend licence" />
                            <TextBlock Text="Test the locks and the unlock screen without buying. Not in Store builds." Style="{StaticResource PaperySecondaryTextStyle}" FontSize="12" />
                        </StackPanel>
                        <ComboBox x:Name="DebugLicenseBox" Grid.Column="1" Width="220" VerticalAlignment="Center" SelectionChanged="OnDebugLicenseChanged" AutomationProperties.Name="Pretend licence">
                            <x:String>Real (ask the Store)</x:String>
                            <x:String>Pretend Free</x:String>
                            <x:String>Pretend Pro</x:String>
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
            <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="App theme" />
                        <TextBlock Text="Light or dark for Papery's windows and menus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="220" VerticalAlignment="Center" SelectionChanged="OnThemeChanged" AutomationProperties.Name="App theme">
                        <x:String>Use my Windows setting</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock Text="Reading" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Page colours" />
                        <TextBlock Text="Dark and Sepia recolour the pages for comfortable reading; pictures keep their colours" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="ReadingBox" Grid.Column="1" Width="220" VerticalAlignment="Center" SelectionChanged="OnReadingChanged" AutomationProperties.Name="Page colours">
                        <x:String>Light (original)</x:String>
                        <x:String>Dark</x:String>
                        <x:String>Sepia</x:String>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Page layout for files you haven't opened before" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox x:Name="LayoutBox" Grid.Column="1" Width="220" VerticalAlignment="Center" SelectionChanged="OnLayoutChanged" AutomationProperties.Name="Default page layout">
                        <x:String>Single page</x:String>
                        <x:String>Continuous scrolling</x:String>
                        <x:String>Two pages side by side</x:String>
                        <x:String>Book</x:String>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reopen files where I left off" />
                        <TextBlock Text="Remembers the page and zoom for each file, on this PC only" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RememberSwitch" Grid.Column="1" Toggled="OnRememberToggled" AutomationProperties.Name="Reopen files where I left off" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Always save a copy" />
                        <TextBlock Text="Your original files are never changed. The first edit asks where to save" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AlwaysCopySwitch" Grid.Column="1" Toggled="OnAlwaysCopyToggled" AutomationProperties.Name="Always save a copy" />
                </Grid>
            </Border>

            <TextBlock Text="Default app" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Open PDFs with Papery" />
                        <TextBlock Text="Windows lets you choose this in its settings. Papery never changes it by itself." TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Choose default apps" Click="OnDefaultAppsClick" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="Privacy" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Your files never leave this PC" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Papery works offline. It has no account, no cloud and no ads, and it doesn't collect any data. The only time it goes online is when the Microsoft Store checks or completes a purchase." />
                    <HyperlinkButton Content="Clear the recent files list" Click="OnClearRecentClick" Padding="0" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/AppIcon-64.png" Width="32" Height="32" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Papery – PDF Editor, Merge &amp; Sign" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Third-party notices" Click="OnNoticesClick" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
