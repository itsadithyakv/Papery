<UserControl
    x:Class="Papery.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Papery.Views"
    xmlns:commands="using:Papery.Commands"
    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <!-- Root Grid also hosts the tour's tips. -->
    <Grid Background="{ThemeResource PaperySurfaceBrush}">
        <ScrollViewer>
            <StackPanel MaxWidth="1080" Padding="40,32,40,48">

                <!-- Header -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Welcome to Papery" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="Open a PDF or pick a tool. Your files never leave this PC." TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="HelpButton" Style="{StaticResource PaperyQuietButtonStyle}" Click="OnHelpClick"
                                AutomationProperties.Name="Help and keyboard shortcuts" ToolTipService.ToolTip="Help and keyboard shortcuts (F1)">
                            <FontIcon Glyph="&#xE897;" FontSize="16" FontFamily="{StaticResource PaperyIcons}" />
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource PaperyQuietButtonStyle}" Click="OnSettingsClick"
                                AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings (Ctrl+,)">
                            <FontIcon Glyph="&#xE713;" FontSize="16" FontFamily="{StaticResource PaperyIcons}" />
                        </Button>
                        <Button x:Name="OpenButton" Style="{StaticResource PaperyPrimaryButtonStyle}" Click="OnOpenClick"
                                Margin="6,0,0,0" ToolTipService.ToolTip="Open a PDF (Ctrl+O)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16" FontFamily="{StaticResource PaperyIcons}" />
                                <TextBlock Text="Open a PDF" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Drop zone -->
                <Grid x:Name="DropZone" Height="140" Margin="0,28,0,0">
                    <Rectangle RadiusX="16" RadiusY="16" StrokeThickness="1.5" StrokeDashArray="5,4"
                               Stroke="{ThemeResource PaperyCoralBrush}" Fill="{ThemeResource PaperyCoralSubtleBrush}" Opacity="0.9" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource PaperyCardBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="{ThemeResource PaperyCoralBrush}" FontFamily="{StaticResource PaperyIcons}" />
                        </Border>
                        <TextBlock Text="Drop a PDF here to get started" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="or press Ctrl+O to choose a file" HorizontalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Getting started: friendly tips, hidden for good with one click. Never a pop-up. -->
                <Border x:Name="GettingStarted" Style="{StaticResource PaperyCardStyle}" Margin="0,20,0,0" Padding="20,16,12,18">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="Getting started" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource PaperyQuietButtonStyle}" Click="OnHideTipsClick"
                                    AutomationProperties.Name="Hide these tips" ToolTipService.ToolTip="Hide these tips">
                                <FontIcon Glyph="&#xE711;" FontSize="12" FontFamily="{StaticResource PaperyIcons}" />
                            </Button>
                        </Grid>
                        <ItemsRepeater x:Name="TipsList" Margin="0,0,8,0">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="320" MinRowSpacing="14" MinColumnSpacing="24" ItemsStretch="Fill" MaximumRowsOrColumns="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:TipItem">
                                    <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource PaperyCoralSubtleBrush}" VerticalAlignment="Top">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource PaperyCoralBrush}" FontFamily="{StaticResource PaperyIcons}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="TourButton" Style="{StaticResource PaperySecondaryButtonStyle}" Click="OnTourClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7BE;" FontSize="14" FontFamily="{StaticResource PaperyIcons}" />
                                    <TextBlock Text="Take the tour" />
                                </StackPanel>
                            </Button>
                            <Button Content="Keyboard shortcuts" Style="{StaticResource PaperySecondaryButtonStyle}" Click="OnHelpClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recent files -->
                <StackPanel x:Name="RecentSection" Margin="0,32,0,0" Spacing="10">
                    <Grid>
                        <TextBlock Text="Recent" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <HyperlinkButton Content="Clear list" HorizontalAlignment="Right" Click="OnClearRecent" />
                    </Grid>
                    <Border Style="{StaticResource PaperyCardStyle}" Padding="4">
                        <ListView x:Name="RecentList" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnRecentClick"
                                  AutomationProperties.Name="Recent files" MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:RecentFileItem">
                                    <Grid ColumnSpacing="12" Padding="4,8" AutomationProperties.Name="{x:Bind Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Remove from list" Click="OnRemoveRecent" Tag="{x:Bind Path}" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <FontIcon Glyph="&#xE8A5;" FontSize="18" Foreground="{ThemeResource PaperyCoralBrush}" FontFamily="{StaticResource PaperyIcons}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Folder}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <!-- All tools -->
                <TextBlock Text="All tools" FontSize="18" FontWeight="SemiBold" Margin="0,32,0,12" />
                <ItemsRepeater x:Name="ToolGrid">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="240" MinItemHeight="92" MinRowSpacing="12" MinColumnSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="commands:ToolInfo">
                            <Button Style="{StaticResource ToolCardStyle}" Tag="{x:Bind}" Click="OnToolClick"
                                    AllowDrop="True" DragOver="OnDragOver" Drop="OnToolDrop"
                                    AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource PaperyCoralSubtleBrush}" VerticalAlignment="Top">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource PaperyCoralBrush}" FontFamily="{StaticResource PaperyIcons}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
