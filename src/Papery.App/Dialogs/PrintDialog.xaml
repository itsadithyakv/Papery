<ContentDialog
    x:Class="Papery.Views.PrintDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Print"
    PrimaryButtonText="Print"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}"
    PrimaryButtonClick="OnPrintClick">

    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="420" Spacing="14" Padding="0,0,12,0">
            <StackPanel Spacing="4">
                <ComboBox x:Name="PrinterBox" Header="Printer" HorizontalAlignment="Stretch" SelectionChanged="OnPrinterChanged" />
                <HyperlinkButton x:Name="PropertiesLink" Content="Printer properties (paper, quality, two-sided)" Click="OnPrinterProperties" Padding="0" />
            </StackPanel>

            <NumberBox x:Name="CopiesBox" Header="Copies" Value="1" Minimum="1" Maximum="999"
                       SpinButtonPlacementMode="Inline" HorizontalAlignment="Left" Width="160" ValueChanged="OnAnyChange" />

            <StackPanel Spacing="6">
                <RadioButtons x:Name="PagesChoice" Header="Pages" SelectedIndex="0" SelectionChanged="OnAnyChange">
                    <x:String>All pages</x:String>
                    <x:String>Current page</x:String>
                    <x:String>Custom range</x:String>
                </RadioButtons>
                <TextBox x:Name="RangeBox" PlaceholderText="For example 1-3, 5, 8-" IsEnabled="False" TextChanged="OnAnyChange"
                         AutomationProperties.Name="Page range" />
                <TextBlock x:Name="RangeError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <ComboBox x:Name="PerSheetBox" Header="Pages per sheet" SelectedIndex="0" Width="200" SelectionChanged="OnAnyChange">
                <x:String>1</x:String>
                <x:String>2</x:String>
                <x:String>4</x:String>
                <x:String>6</x:String>
                <x:String>9</x:String>
                <x:String>16</x:String>
            </ComboBox>

            <CheckBox x:Name="BookletBox" Checked="OnAnyChange" Unchecked="OnAnyChange">
                <TextBlock TextWrapping="Wrap" Text="Booklet: print on both sides (flip on the short edge), then fold the stack in half" />
            </CheckBox>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="ScalingBox" Header="Scaling" SelectedIndex="1" Width="220" SelectionChanged="OnAnyChange">
                    <x:String>Fit to paper</x:String>
                    <x:String>Shrink large pages only</x:String>
                    <x:String>Actual size</x:String>
                    <x:String>Custom</x:String>
                </ComboBox>
                <NumberBox x:Name="CustomScaleBox" Header="Scale (%)" Value="100" Minimum="10" Maximum="400" Width="120" Visibility="Collapsed" />
            </StackPanel>

            <ComboBox x:Name="OrientationBox" Header="Orientation" SelectedIndex="0" Width="200">
                <x:String>Automatic</x:String>
                <x:String>Portrait</x:String>
                <x:String>Landscape</x:String>
            </ComboBox>

            <ToggleSwitch x:Name="GrayscaleSwitch" Header="Black and white" OffContent="Colour" OnContent="Black and white" />

            <TextBlock x:Name="Summary" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
