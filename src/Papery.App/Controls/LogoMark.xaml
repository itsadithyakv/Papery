<!--
  Papery's mark, the same as the app icon: a coral rounded square with a white folded page.
  Drawn with shapes so it stays crisp at any size. Brand coral in every theme, like the icon.
  Decorative: hidden from Narrator (the surrounding text says what's going on).
-->
<UserControl
    x:Class="Papery.Controls.LogoMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">

    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="100">
            <Rectangle Width="100" Height="100" RadiusX="20" RadiusY="20" Fill="#E5533D" />
            <Path Data="M 27,19 L 57,19 L 73,35 L 73,81 L 27,81 Z" Fill="#FFFFFF" />
            <Path Data="M 57,19 L 73,35 L 57,35 Z" Fill="#FACDC4" />
        </Canvas>
    </Viewbox>
</UserControl>
