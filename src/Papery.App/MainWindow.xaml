<Window
    x:Class="Papery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Papery">

    <!-- KeyboardAcceleratorPlacementMode="Hidden": window-wide shortcuts must not show a hover hint everywhere. -->
    <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" KeyboardAcceleratorPlacementMode="Hidden"
          Background="{ThemeResource PaperyChromeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnOpenShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="T" Invoked="OnNewTabShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="OnCloseTabShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="F4" Invoked="OnCloseTabShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="Tab" Invoked="OnNextTabShortcut" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="Tab" Invoked="OnPreviousTabShortcut" />
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnCommandPaletteShortcut" />
            <KeyboardAccelerator Key="F1" Invoked="OnHelpShortcut" />
        </Grid.KeyboardAccelerators>

        <TabView x:Name="Tabs"
                 IsAddTabButtonVisible="True"
                 CanReorderTabs="True"
                 CanDragTabs="True"
                 CanTearOutTabs="True"
                 TabWidthMode="SizeToContent"
                 AddTabButtonClick="OnAddTabClick"
                 TabCloseRequested="OnTabCloseRequested"
                 SelectionChanged="OnTabSelectionChanged"
                 TabTearOutWindowRequested="OnTabTearOutWindowRequested"
                 TabTearOutRequested="OnTabTearOutRequested"
                 ExternalTornOutTabsDropping="OnExternalTabsDropping"
                 ExternalTornOutTabsDropped="OnExternalTabsDropped">
            <TabView.TabStripHeader>
                <!-- Just a little space before the first tab (no icon: the taskbar already shows it). -->
                <Border Width="8" />
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <!--
                  Empty title bar space: drag here to move the window. Nothing clickable goes in here,
                  because Windows treats this whole area as the title bar. Width leaves room for the caption buttons.
                -->
                <Grid x:Name="DragRegion" Background="Transparent" MinWidth="188" />
            </TabView.TabStripFooter>
        </TabView>
    </Grid>
</Window>
