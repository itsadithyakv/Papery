<!--
  Papery.Pdf: the PDF engine layer.
  Wraps native PDFium (rendering, text, search, forms, annotations) behind a small,
  thread-safe C# API. Nothing in here knows about the UI.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Papery.Pdf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" />
    <!-- Writes bookmarks into new documents (PDFium can't). Pinned to 6.2.4, the last MIT release. -->
    <PackageReference Include="PDFsharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Papery.Pdf.Tests" />
  </ItemGroup>
  <!-- QPDF 12.4.2 (Apache-2.0), official Windows builds: lossless size reduction when compressing. -->
  <PropertyGroup>
    <QpdfArch Condition="'$(Platform)' == 'ARM64' Or '$(RuntimeIdentifier)' == 'win-arm64'">arm64</QpdfArch>
    <QpdfArch Condition="'$(QpdfArch)' == ''">x64</QpdfArch>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\third_party\qpdf\$(QpdfArch)\*" Link="qpdf\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
