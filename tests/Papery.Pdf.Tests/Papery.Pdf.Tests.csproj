<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Test names use underscores for readability; async tests don't need ConfigureAwait. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Used only to build small fixture PDFs inside the tests. -->
    <PackageReference Include="PDFsharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Papery.Pdf\Papery.Pdf.csproj" />
  </ItemGroup>
</Project>
